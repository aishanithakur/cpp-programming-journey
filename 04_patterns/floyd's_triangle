#include <iostream>
using namespace std;

int floyd(int n){
    int num=1;                 // number is initialised to 1 which later increases by 1
    for(int i=1; i<=n; i++){
        for(int j=1; j<=i; j++){  
         cout << num;             // number is printed then is updated by incrementing by 1
         num++;                  
        }
         cout << endl;           //so that line changes after every loop
    }
     return num;
}
int main(){
    int n;
    cout << "Enter n: ";
    cin >> n;
    int floyd(n);
    return 0;
}
